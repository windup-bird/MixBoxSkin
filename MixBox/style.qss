/* Mixbox v2 — Modern blue theme */
/* 调色板：底色 #0b1017 / #141a24 / #1c2430 / #26303e，线 #2c3646
   文字 #e9eef6 / #a2b1c6 / #7688a0
   强调 #3d8bfd，高亮 #63a4ff，选中底 #16243c
   Deck1 #3d8bfd  Deck2 #22d3ee  Deck3 #8b7cf8  Deck4 #ee7fb0
   语义 cue #f87171  loop #34d399  master #fbbf24 */
/* ================================================================ */

/************** Fonts **********************************************/
#Mixxx, WWidget, WLabel, WNumber, WNumberPos, WNumberRate,
WPushButton, WKey, WTime, WTrackProperty, WRateRange,
WRecordingDuration, WEffectSelector, WEffectParameterName,
WEffectChainPresetSelector, WCoverArt, WOverview,
WEffectMetaKnob, WBeatSpinBox {
  font-family: "Inter", "Open Sans Semibold", "Open Sans";
  font-weight: 500; font-style: normal;
}
#DeckTitle, #KeyText, #BpmText, #DeckTime,
#ToolbarButton[value="1"], #RecButton[value="1"] {
  font-family: "Inter", "Open Sans"; font-weight: bold;
}

/************** Root ***********************************************/
#Mixxx { background-color: #0b1017; }

/************** Toolbar ********************************************/
#Toolbar { background-color: #0b1017; padding: 3px 4px; }
#ToolbarButton {
  background-color: #1c2430; color: #a2b1c6;
  border: none; border-radius: 6px; font-size: 11px; font-weight: bold;
  min-width: 60px; min-height: 26px; padding: 2px 10px;
}
#ToolbarButton[value="1"] { background-color: #3d8bfd; color: #0b1017; }
#ClockLabel { color: #e9eef6; font-size: 14px; font-weight: bold; }
#MiniVuMeter { background-color: #141a24; border: none; border-radius: 2px; }
#RecButton { background-color: #1c2430; color: #a2b1c6; border: none; border-radius: 6px; font-size: 10px; font-weight: bold; min-height: 26px; }
#RecButton[value="1"], #RecButton[highlight="1"] { background-color: #f87171; color: #fff; }
#RecDuration { color: #a2b1c6; font-size: 12px; }
#RecDuration[highlight="1"] { color: #f87171; font-weight: bold; }

/************** Waveform *******************************************/
#WaveformArea { background-color: #0a0f16; margin: 1px 0px; }
#WfDeckLabel1, #WfDeckLabel2, #WfDeckLabel3, #WfDeckLabel4 { background-color: transparent; }
#WfDeckNum { color: #e9eef6; font-size: 20px; font-weight: bold; }
#WfDeckLabel1 #WfDeckNum { color: #3d8bfd; }
#WfDeckLabel2 #WfDeckNum { color: #22d3ee; }
#WfDeckLabel3 #WfDeckNum { color: #8b7cf8; }
#WfDeckLabel4 #WfDeckNum { color: #ee7fb0; }

/************** Library *******************************************/
#LibraryContainer { background-color: #0b1017; padding: 2px; }
#LibSidebar { background-color: #0b1017; border-right: 1px solid #2c3646; }
#LibSplitter { background-color: #0b1017; }
WSearchBox, WSearchLineEdit {
  background-color: #141a24; color: #e9eef6;
  border: 1px solid #2c3646; border-radius: 8px; margin: 4px; padding: 8px 12px; font-size: 16px;
  min-height: 44px;
}
WLibrary, WLibrary QTableView, WTrackTableView {
  background-color: #0b1017; color: #e9eef6; border: none;
  alternate-background-color: #141a24;
  selection-background-color: #16243c; selection-color: #3d8bfd; font-size: 15px;
}
WTrackTableView { row-height: 52px; }
WTrackTableView::item, WTrackTableView QTableView::item {
  min-height: 52px; padding: 4px 8px;
}
WLibrary QHeaderView::section, WTrackTableViewHeader::section {
  background-color: #141a24; color: #a2b1c6; border: none;
  border-bottom: 1px solid #2c3646; font-size: 12px; padding: 8px;
  min-height: 36px;
}
WLibrarySidebar { background-color: #0b1017; color: #a2b1c6; border: none; font-size: 15px; }
WLibrarySidebar::item { min-height: 44px; padding: 8px; }
WLibrarySidebar::item:selected { background-color: #16243c; color: #3d8bfd; }

/************** Pads ***********************************************/
#PadPageTitle { color: #3d8bfd; font-size: 9px; font-weight: bold; margin-bottom: 1px; }
#PadRow, #LoopRow, #JumpRow { background-color: transparent; margin: 1px 0px; }
#HotcuePad {
  background-color: #1c2430; color: #a2b1c6;
  border: none; border-radius: 6px; font-size: 16px; font-weight: bold; margin: 2px;
  min-width: 40px; min-height: 30px;
}
#HotcuePad[value="1"], #HotcuePad[highlight="1"] { color: #fff; }

/************** Loop/Beatjump Controls ******************************/
#LoopControl, #BeatjumpControl { background-color: #141a24; border-radius: 8px; padding: 0px; }
#LoopSizeBtn, #JumpSizeBtn {
  background-color: #1c2430; color: #a2b1c6;
  border: none; border-radius: 6px; font-size: 16px; font-weight: bold;
  min-width: 48px; min-height: 30px;
}
#LoopSizeBtn:hover, #JumpSizeBtn:hover { color: #3d8bfd; }
#LoopSizeSpinBox, #JumpSizeSpinBox {
  background-color: #141a24; color: #e9eef6;
  border: 1px solid #2c3646; border-radius: 6px; font-size: 15px; font-weight: bold;
  min-width: 48px; min-height: 30px;
}
#LoopInOutBtn {
  background-color: #1c2430; color: #a2b1c6;
  border: none; border-radius: 6px; font-size: 13px; font-weight: bold;
  min-width: 48px; min-height: 30px;
}
#LoopInOutBtn:hover { color: #34d399; }
#LoopInOutBtn[pressed="true"], #LoopInOutBtn[highlight="1"] { background-color: #34d399; color: #0b1017; }
#JumpBtn {
  background-color: #1c2430; color: #63a4ff;
  border: none; border-radius: 6px; font-size: 16px; font-weight: bold;
  min-width: 48px; min-height: 30px;
}
#JumpBtn:hover { background-color: #63a4ff; color: #0b1017; }
WBeatSpinBox { background-color: #141a24; color: #e9eef6; border: 1px solid #2c3646; border-radius: 6px; font-size: 14px; min-height: 24px; }
WBeatSpinBox::up-button, WBeatSpinBox::down-button { width: 0px; height: 0px; subcontrol-origin: margin; subcontrol-position: top right; }
WBeatSpinBox::down-arrow, WBeatSpinBox::up-arrow { width: 0px; height: 0px; }

/************** FX *************************************************/
#FxPadArea { background-color: #141a24; margin: 1px 0px; padding: 3px 2px; }
#FxCenterBlock { background-color: transparent; padding: 2px 4px; border-radius: 6px; }
#FxSectionLabel { color: #3d8bfd; font-size: 10px; font-weight: bold; }
#FxSlotBox, #ColorFxSlotBox { background-color: transparent; margin: 0px 2px; }
WEffectMetaKnob, KnobComposed { background-color: transparent; }
#FxKnobRow, #ColorFxKnobRow { background-color: transparent; }
WEffectParameterName, #FxSlotName { color: #a2b1c6; font-size: 9px; font-weight: bold; }
#FxSlotName[highlight="1"] { color: #3d8bfd; }
#ColorFxSlotName { color: #3d8bfd; font-size: 10px; font-weight: bold; }
WEffectSelector, #FxSlotSelector {
  background-color: #141a24; color: #3d8bfd;
  border: 1px solid #2c3646; border-radius: 4px; font-size: 10px; padding: 3px;
  min-width: 0px; min-height: 24px;
}
WEffectChainPresetSelector#QuickEffectSelectorLeft {
  background-color: #141a24; color: #3d8bfd;
  border: 1px solid #2c3646; border-radius: 4px; font-size: 10px; padding: 3px 4px;
  min-width: 0px; min-height: 24px;
}

/************** Deck Cards *****************************************/
#DeckArea { background-color: #0b1017; padding: 0px; }
#DeckInfoCard { background-color: #141a24; border: none; border-radius: 10px; margin: 1px 1px; padding: 4px 4px; }
#DeckNumber { color: #e9eef6; font-size: 24px; font-weight: bold; }
WCoverArt { background-color: #0b1017; border: none; border-radius: 8px; }

#DeckTitle { color: #e9eef6; font-size: 16px; font-weight: bold; padding: 0px 3px; }
#DeckArtist { color: #a2b1c6; font-size: 13px; padding: 0px 3px; }

#MetaMini { color: #7688a0; font-size: 8px; }
#KeyText { color: #fbbf24; font-size: 16px; font-weight: bold; }
#BpmText { color: #e9eef6; font-size: 16px; font-weight: bold; }
#DeckTime { color: #e9eef6; font-size: 16px; font-weight: bold; }

#SyncButton { background-color: #1c2430; color: #a2b1c6; border: none; border-radius: 6px; font-size: 10px; font-weight: bold; min-width: 44px; min-height: 20px; }
#SyncButton[value="1"] { background-color: #63a4ff; color: #0b1017; }
#SyncButton[highlight="1"] { background-color: #fbbf24; color: #0b1017; }

#MTButton { background-color: #1c2430; color: #a2b1c6; border: none; border-radius: 6px; font-size: 10px; font-weight: bold; min-width: 44px; min-height: 20px; }
#MTButton[value="1"] { background-color: #3d8bfd; color: #0b1017; }

#RateRangeText { color: #a2b1c6; font-size: 11px; }
#RateDeltaText { color: #e9eef6; font-size: 12px; font-weight: bold; }

/************** Overview (half-wave clipped) ***********************/
#DeckOverviewClip { background-color: #0a0f16; border: none; overflow: hidden; }
#DeckOverview { margin: 50% 0; }
WOverview { background-color: #0a0f16; border: none; }

/************** Settings ******************************************/
#SettingsPanel { background-color: #1c2430; margin: 2px 0px; border-radius: 10px; padding: 8px; }

/************** Misc ***********************************************/
#ToolbarSpacer { background-color: transparent; }
