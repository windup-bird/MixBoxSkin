      </EffectParameterName>
      <EffectSelector>
        <ObjectName>FxSlotSelector</ObjectName><Size>0me,22f</Size>
        <EffectRack>1</EffectRack><EffectUnit><Variable name="FxUnit"/></EffectUnit><Effect><Variable name="FxNum"/></Effect>
      </EffectSelector>
      <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
