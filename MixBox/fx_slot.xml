<Template>
  <WidgetGroup>
    <ObjectName>FxSlotBox</ObjectName><Layout>vertical</Layout><SizePolicy>min,me</SizePolicy>
    <Children>
      <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
      <WidgetGroup>
        <ObjectName>FxKnobRow</ObjectName><Layout>horizontal</Layout><SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
          <EffectMetaKnob>
            <Size>38f,38f</Size>
            <MinAngle>-120</MinAngle><MaxAngle>120</MaxAngle>
            <ArcRadius>13</ArcRadius><ArcThickness>3</ArcThickness>
            <ArcBgColor>#2c3646</ArcBgColor><ArcBgThickness>2</ArcBgThickness>
