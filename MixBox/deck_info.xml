<Template>
  <WidgetGroup>
    <ObjectName>DeckInfoCard</ObjectName>
    <Layout>horizontal</Layout>
    <Size>0me,100f</Size>
    <Children>

      <!-- Deck number -->
      <WidgetGroup>
        <Layout>vertical</Layout><Size>32f,0me</Size>
        <Children>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
          <Label><ObjectName>DeckNumber</ObjectName><Size>32f,32f</Size>
            <Text><Variable name="ChanNum"/></Text><Alignment>center</Alignment></Label>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <!-- Main column: Track info + Meta on top, Overview below -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>i,me</SizePolicy>
        <Children>

          <!-- ═══ UPPER HALF: cover + title + meta ═══ -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <!-- Cover art（在 overview 上方） -->
              <WidgetGroup>
                <Layout>vertical</Layout><Size>60f,0me</Size><SizePolicy>min,me</SizePolicy>
                <Children>
                  <CoverArt>
                    <SizePolicy>me,me</SizePolicy><Group><Variable name="Group"/></Group>
                    <Connection><ConfigKey>[Skin],show_coverart</ConfigKey><BindProperty>visible</BindProperty></Connection>
                  </CoverArt>
                </Children>
              </WidgetGroup>

              <!-- Track Title + Artist -->
              <WidgetGroup><Layout>vertical</Layout><SizePolicy>i,me</SizePolicy>
                <Children>
                  <WidgetGroup><Size>0min,1f</Size></WidgetGroup>
                  <TrackProperty>
                    <ObjectName>DeckTitle</ObjectName><Size>0me,18f</Size>
                    <Property>titleInfo</Property><Alignment>Left</Alignment><Elide>right</Elide>
                    <Channel><Variable name="ChanNum"/></Channel>
                  </TrackProperty>
                  <TrackProperty>
                    <ObjectName>DeckArtist</ObjectName><Size>0me,14f</Size>
                    <Property>artist</Property><Alignment>Left</Alignment><Elide>right</Elide>
                    <Channel><Variable name="ChanNum"/></Channel>
                  </TrackProperty>
                  <WidgetGroup><Size>0min,1f</Size></WidgetGroup>
                </Children>
              </WidgetGroup>

              <!-- Meta cluster -->
              <WidgetGroup>
                <Layout>horizontal</Layout><SizePolicy>max,me</SizePolicy><MinimumSize>300,</MinimumSize>
                <Children>

                  <WidgetGroup><Layout>vertical</Layout><SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Label><ObjectName>MetaMini</ObjectName><Size>0me,10f</Size><Text>TIME</Text><Alignment>center</Alignment></Label>
                      <WidgetGroup><Size>0min,1f</Size></WidgetGroup>
                      <NumberPos>
                        <ObjectName>DeckTime</ObjectName><Size>0me,20f</Size>
                        <Alignment>center</Alignment><NumberOfDigits>6</NumberOfDigits>
                        <Channel><Variable name="ChanNum"/></Channel>
                        <Connection><ConfigKey><Variable name="Group"/>,playposition</ConfigKey></Connection>
                      </NumberPos>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup><Size>4f,min</Size></WidgetGroup>

                  <WidgetGroup><Layout>vertical</Layout><SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Label><ObjectName>MetaMini</ObjectName><Size>0me,10f</Size><Text>KEY</Text><Alignment>center</Alignment></Label>
                      <WidgetGroup><Size>0min,2f</Size></WidgetGroup>
                      <TrackProperty>
                        <ObjectName>KeyText</ObjectName><Size>0me,20f</Size>
                        <Property>keyText</Property><Alignment>center</Alignment>
                        <Channel><Variable name="ChanNum"/></Channel>
                      </TrackProperty>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup><Size>4f,min</Size></WidgetGroup>

                  <WidgetGroup><Layout>vertical</Layout><SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Label><ObjectName>MetaMini</ObjectName><Size>0me,10f</Size><Text>BPM</Text><Alignment>center</Alignment></Label>
                      <WidgetGroup><Size>0min,1f</Size></WidgetGroup>
                      <Number>
                        <ObjectName>BpmText</ObjectName><Size>0me,20f</Size>
                        <Alignment>center</Alignment><NumberOfDigits>2</NumberOfDigits>
                        <Connection><ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey></Connection>
                      </Number>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup><Size>4f,min</Size></WidgetGroup>

                  <WidgetGroup><Layout>vertical</Layout><SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Label><ObjectName>MetaMini</ObjectName><Size>0me,10f</Size><Text>RANGE</Text><Alignment>center</Alignment></Label>
                      <WidgetGroup><Size>0min,2f</Size></WidgetGroup>
                      <RateRange>
                        <ObjectName>RateRangeText</ObjectName><Size>0me,10f</Size>
                        <Alignment>center</Alignment><Channel><Variable name="ChanNum"/></Channel>
                        <Display>range</Display>
                      </RateRange>
                      <NumberRate>
                        <ObjectName>RateDeltaText</ObjectName><Size>0me,12f</Size>
                        <Alignment>center</Alignment><Channel><Variable name="ChanNum"/></Channel><NumberOfDigits>2</NumberOfDigits>
                      </NumberRate>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup><Size>4f,min</Size></WidgetGroup>

                  <!-- SYNC + MT：固定高度（真实生效，不再被 me 撑满），上下居中 -->
                  <WidgetGroup><Layout>vertical</Layout><SizePolicy>min,me</SizePolicy><MinimumSize>52,</MinimumSize>
                    <Children>
                      <WidgetGroup><SizePolicy>me,me</SizePolicy></WidgetGroup>
                      <PushButton>
                        <ObjectName>SyncButton</ObjectName><Size>48f,20f</Size><NumberStates>2</NumberStates>
                        <State><Number>0</Number><Text>SYNC</Text></State><State><Number>1</Number><Text>SYNC</Text></State>
                        <Connection><ConfigKey><Variable name="Group"/>,sync_enabled</ConfigKey><ButtonState>LeftButton</ButtonState></Connection>
                        <Connection><ConfigKey><Variable name="Group"/>,sync_leader</ConfigKey><ButtonState>RightButton</ButtonState></Connection>
                        <Connection><ConfigKey><Variable name="Group"/>,sync_leader</ConfigKey><BindProperty>highlight</BindProperty></Connection>
                        <Connection><ConfigKey><Variable name="Group"/>,sync_leader</ConfigKey><BindProperty>text</BindProperty>
                          <Transform><IsEqual>1</IsEqual><SetValue>MASTER</SetValue></Transform>
                          <Transform><IsEqual>0</IsEqual><SetValue>SYNC</SetValue></Transform>
                        </Connection>
                      </PushButton>
                      <WidgetGroup><Size>0min,2f</Size></WidgetGroup>
                      <PushButton>
                        <ObjectName>MTButton</ObjectName><Size>48f,20f</Size><NumberStates>2</NumberStates>
                        <State><Number>0</Number><Text>MT</Text></State><State><Number>1</Number><Text>MT</Text></State>
                        <Connection><ConfigKey><Variable name="Group"/>,keylock</ConfigKey></Connection>
                      </PushButton>
                      <WidgetGroup><SizePolicy>me,me</SizePolicy></WidgetGroup>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <!-- ═══ OVERVIEW: half-wave clipped ═══ -->
          <WidgetGroup>
            <ObjectName>DeckOverviewClip</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <Overview>
                <ObjectName>DeckOverview</ObjectName>
                <Size>0me,100f</Size>
                <Group><Variable name="Group"/></Group>
                <BgColor><Variable name="WaveformBg"/></BgColor>
                <SignalColor><Variable name="Accent"/></SignalColor>
                <SignalLowColor><Variable name="WfLow"/></SignalLowColor><SignalMidColor><Variable name="WfMid"/></SignalMidColor><SignalHighColor><Variable name="WfHigh"/></SignalHighColor>
                <PlayPosColor><Variable name="WfPlay"/></PlayPosColor>
                <PlayedOverlayColor>#a62e343d</PlayedOverlayColor>
                <DefaultMark>
                  <Align>bottom|right</Align>
                  <Color><Variable name="CueColor"/></Color>
                  <TextColor><Variable name="WfPlay"/></TextColor>
                  <Text> %1 </Text>
                </DefaultMark>
                <Mark><Control>cue_point</Control><Text>CUE</Text><Color><Variable name="CueColor"/></Color><TextColor><Variable name="CueColor"/></TextColor><Align>top|right</Align></Mark>
                <Mark><Control>loop_start_position</Control><Text>IN</Text><Color><Variable name="LoopColor"/></Color><TextColor><Variable name="LoopColor"/></TextColor><Align>bottom</Align></Mark>
                <Mark><Control>loop_end_position</Control><Text>OUT</Text><Color><Variable name="LoopColor"/></Color><TextColor><Variable name="LoopColor"/></TextColor><Align>bottom</Align></Mark>
                <MarkRange><StartControl>loop_start_position</StartControl><EndControl>loop_end_position</EndControl>
                  <EnabledControl>loop_enabled</EnabledControl><Color><Variable name="LoopColor"/></Color><Opacity>0.8</Opacity>
                  <DisabledColor><Variable name="TextLow"/></DisabledColor><DisabledOpacity>0.4</DisabledOpacity></MarkRange>
                <Connection><ConfigKey><Variable name="Group"/>,playposition</ConfigKey></Connection>
              </Overview>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
