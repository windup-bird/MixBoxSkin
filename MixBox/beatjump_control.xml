<!--
  Description:
    Beatjump block: jump size (half / size box / double) and back / forward.
    Row heights mirror hotcue_pad so the rows line up with the pads.
  Variables:
    ChanNum : deck number (1-4)
-->
<Template>
  <WidgetGroup>
    <ObjectName>BeatjumpControl</ObjectName><Layout>vertical</Layout><SizePolicy>me,me</SizePolicy>
    <Children>
      <!-- Row 1: size control（与 hotcue 垫第一行同构、等比弹性，故纵向对齐） -->
      <WidgetGroup><ObjectName>JumpRow</ObjectName><Layout>horizontal</Layout><Size>0me,0me</Size><SizePolicy>me,me</SizePolicy>
        <Children>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
          <PushButton>
            <ObjectName>JumpSizeBtn</ObjectName><SizePolicy>me,me</SizePolicy>
            <NumberStates>1</NumberStates><State><Number>0</Number><Text>&lt;</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="ChanNum"/>],beatjump_size_halve</ConfigKey></Connection>
          </PushButton>
          <WidgetGroup><Size>3f,min</Size></WidgetGroup>
          <BeatSpinBox>
            <ObjectName>JumpSizeSpinBox</ObjectName><SizePolicy>me,me</SizePolicy><MinimumSize>36,0</MinimumSize><MaximumSize>48,40</MaximumSize>
            <Value>[Channel<Variable name="ChanNum"/>],beatjump_size</Value>
          </BeatSpinBox>
          <WidgetGroup><Size>3f,min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>JumpSizeBtn</ObjectName><SizePolicy>me,me</SizePolicy>
            <NumberStates>1</NumberStates><State><Number>0</Number><Text>&gt;</Text></State>
            <Connection><ConfigKey>[Channel<Variable name="ChanNum"/>],beatjump_size_double</ConfigKey></Connection>
          </PushButton>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>
      <!-- Row 2: jump buttons -->
      <WidgetGroup><ObjectName>JumpRow</ObjectName><Layout>horizontal</Layout><Size>0me,0me</Size><SizePolicy>me,me</SizePolicy>
        <Children>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
          <PushButton>
            <ObjectName>JumpBtn</ObjectName><SizePolicy>me,me</SizePolicy>
            <NumberStates>1</NumberStates><RightClickIsPushButton>true</RightClickIsPushButton>
            <State><Number>0</Number><Text>&lt;&lt;</Text><Alignment>center</Alignment></State>
            <Connection><ConfigKey>[Channel<Variable name="ChanNum"/>],beatjump_backward</ConfigKey><ButtonState>LeftButton</ButtonState></Connection>
            <Connection><ConfigKey>[Channel<Variable name="ChanNum"/>],beatjump_1_backward</ConfigKey><ButtonState>RightButton</ButtonState></Connection>
          </PushButton>
          <WidgetGroup><Size>3f,min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>JumpBtn</ObjectName><SizePolicy>me,me</SizePolicy>
            <NumberStates>1</NumberStates><RightClickIsPushButton>true</RightClickIsPushButton>
            <State><Number>0</Number><Text>&gt;&gt;</Text><Alignment>center</Alignment></State>
            <Connection><ConfigKey>[Channel<Variable name="ChanNum"/>],beatjump_forward</ConfigKey><ButtonState>LeftButton</ButtonState></Connection>
            <Connection><ConfigKey>[Channel<Variable name="ChanNum"/>],beatjump_1_forward</ConfigKey><ButtonState>RightButton</ButtonState></Connection>
          </PushButton>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
