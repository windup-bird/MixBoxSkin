<Template>
  <PushButton>
    <ObjectName>HotcuePad</ObjectName>
    <Size>0me,0me</Size>
    <NumberStates>2</NumberStates>
    <State><Number>0</Number><Text><Variable name="PadNum"/></Text></State>
    <State><Number>1</Number><Text><Variable name="PadNum"/></Text></State>
    <Connection>
      <ConfigKey>[Channel<Variable name="ChanNum"/>],hotcue_<Variable name="PadNum"/>_activate</ConfigKey>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
    <Connection>
      <ConfigKey>[Channel<Variable name="ChanNum"/>],hotcue_<Variable name="PadNum"/>_clear</ConfigKey>
      <ButtonState>RightButton</ButtonState>
    </Connection>
    <Connection>
      <ConfigKey>[Channel<Variable name="ChanNum"/>],hotcue_<Variable name="PadNum"/>_status</ConfigKey>
      <BindProperty>highlight</BindProperty>
      <Transform><Not/><IsEqual>0</IsEqual></Transform>
    </Connection>
    <Connection>
      <ConfigKey>[Channel<Variable name="ChanNum"/>],hotcue_<Variable name="PadNum"/>_color</ConfigKey>
      <BindProperty>bgColor</BindProperty>
    </Connection>
  </PushButton>
</Template>
